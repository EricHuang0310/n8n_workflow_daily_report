      "name": "get_workflow"
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "# 對應 Python 原腳本: build_execution_api_url() 中取 projectId 的部分。\n# 從 workflow 回應的 shared[0].projectId 取出 projectId，缺少就明確報錯。\npayload = _input.first().json\n\n# n8n 傳進來的是 JS 物件代理，轉成 Python dict 後才好操作。\nif hasattr(payload, 'to_py'):\n    payload = payload.to_py()\n\nshared = payload.get('shared')\nif not isinstance(shared, list) or len(shared) == 0:\n    raise Exception('workflow 回應缺少 shared 資料')\n\nproject_id = shared[0].get('projectId') or ''\nif not project_id:\n    raise Exception('workflow 回應缺少 projectId')\n\nreturn [{'json': {'projectId': project_id}}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [656, 1104],
      "id": "c099cf11-25b5-46df-ae48-7dd365635d31",
      "name": "extract_project_id"
    },
    {
      "parameters": {
        "url": "={{ $('config').first().json.n8nBaseUrl }}/api/v1/executions",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "includeData",
              "value": "true"
            },
            {
              "name": "workflowId",
              "value": "={{ $('config').first().json.workflowId }}"
            },
            {
              "name": "projectId",
              "value": "={{ $json.projectId }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
