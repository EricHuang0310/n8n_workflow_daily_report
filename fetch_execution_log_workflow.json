            {
              "name": "X-N8N-API-KEY",
              "value": "={{ $('config').first().json.apiKey }}"
            },
            {
              "name": "accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": "={{ $('config').first().json.timeoutMs }}",
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "cursor",
                    "value": "={{ $response.body.nextCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.nextCursor || (($response.body.data || []).length > 0 && String($response.body.data[$response.body.data.length - 1].startedAt || '').slice(0, 10) < $('config').first().json.targetYmd) }}",
              "limitPagesFetched": true,
              "maxRequests": "={{ $('config').first().json.maxPages }}"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [896, 1104],
      "id": "640c7024-5219-42b1-9636-b57d64161904",
      "name": "fetch_executions"
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "# 對應 Python 原腳本: fetch_execution_log() 的日期篩選 + scrub_pii()\n#\n# 上游 fetch_executions 已用 HTTP Request 內建分頁抓完所有頁，\n# 每一頁是一個 item，這裡先合併再篩日期，最後遞迴去個資。\n#\n# 註：n8n 的 Python Code node 跑在 Pyodide 上，沒有網路能力，\n#     所以「發請求／分頁」留在 HTTP Request 節點做，Python 只處理資料。\n\nPII_KEYS = {'customerID', 'phone'}\n\n# 用 dict 當計數器（而非 global 變數），這樣不論 n8n 是把這段程式\n# 放在模組層級還是包進函式裡執行，計數都能正常運作。\ncounter = {'removed': 0}\n\n\ndef scrub_pii(obj, counter):\n    \"\"\"遞迴移除任意層級中的個資欄位（就地修改）。\n\n    customerID / phone 散落在 receive_message_API、extract_intent、\n    receive_confirmation 等 20 多個節點，因此以「key 名稱」為準遞迴清除，\n    而不是只清單一條路徑，才能確保完整去個資。\n    只比對完全相同的 key，不會誤刪 phone_number 等欄位。\n    \"\"\"\n    if isinstance(obj, list):\n        for item in obj:\n            scrub_pii(item, counter)\n        return obj\n    if isinstance(obj, dict):\n        for key in list(obj.keys()):\n            if key in PII_KEYS:\n                del obj[key]\n                counter['removed'] += 1\n            else:\n                scrub_pii(obj[key], counter)\n    return obj\n\n\ndef to_dict(value):\n    \"\"\"把 n8n 傳來的 JS 物件代理轉成純 Python 結構。\"\"\"\n    if hasattr(value, 'to_py'):\n        return value.to_py()\n    return value\n\n\ncfg = to_dict(_('config').first().json)\n\ntarget_date = str(cfg.get('targetDate') or '')\ntarget_ymd = None\nif target_date:\n    target_ymd = target_date[0:4] + '-' + target_date[4:6] + '-' + target_date[6:8]\n\n# 合併所有分頁，並在合併時就篩掉非目標日期的資料。\nall_executions = []\npages_fetched = 0\n\nfor item in _input.all():\n    page = to_dict(item.json)\n    pages_fetched += 1\n\n    for ex in (page.get('data') or []):\n        date_ymd = str(ex.get('startedAt') or '')[0:10]\n        if target_ymd is None or date_ymd == target_ymd:\n            all_executions.append(ex)\n\nscrub_pii(all_executions, counter)\n\nreturn [\n    {\n        'json': {\n            'data': all_executions,\n            'stats': {\n                'targetDate': target_date,\n                'pagesFetched': pages_fetched,\n                'total': len(all_executions),\n                'piiKeysRemoved': counter['removed'],\n                'piiKeys': sorted(PII_KEYS),\n            },\n        }\n    }\n]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1136, 1104],
      "id": "4ecc85c0-7210-4867-909d-61cc6a95bf71",
      "name": "filter_and_scrub"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"data\": $json.data } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1392, 1104],
      "id": "f6b65d29-d3c2-431c-ae58-129393abee4a",
      "name": "respond_json"
    },
    {
      "parameters": {
        "content": "## 設定區\n\n在 `config` 節點調整：\n\n- **targetDate**：預設抓「昨天」(yyyyMMdd)。\n  要補跑改成固定值，例如 `20260518`。\n- **targetYmd**：同一天的 `yyyy-MM-dd` 格式，\n  供分頁提前停止的判斷式使用，\n  改 targetDate 時**要一起改**。\n- **maxPages**：分頁上限，避免無限迴圈。\n- **outputDir**：目前流程直接回傳 JSON，\n  沒有寫檔，此欄位保留但未使用。",
        "height": 360,
        "width": 320,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [160, 720],
      "id": "47900296-b282-407a-9e45-7298554fcb58",
      "name": "note_config"
    },
    {
      "parameters": {
        "content": "## Python 版資料處理\n\n`extract_project_id` 與 `filter_and_scrub`\n都是 **Python (Beta)** Code node。\n\n⚠️ n8n 的 Python 跑在 Pyodide (WASM)，\n**沒有網路能力**（無 requests、\n也無 JS 的 this.helpers.httpRequest），\n所以「發請求 + cursor 分頁」改由\n`fetch_executions` 的 HTTP Request\n內建 Pagination 負責。\n\n去個資：遞迴移除任何層級的\n`customerID` 與 `phone`，\n只比對完全相同的 key，\n不會誤刪 `phone_number`。",
        "height": 420,
        "width": 320,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1104, 640],
      "id": "617b88d1-ad10-4f41-a162-175ac300900b",
      "name": "note_pii"
    }
